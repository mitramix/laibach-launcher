<?xml version="1.0" encoding="utf-8"?>
<!-- A screen of the state rises into place over the one before. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/linear_out_slow_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <translate android:fromYDelta="4%" android:toYDelta="0" android:duration="340" />
</set>
