<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Home" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/opus_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- The screens opened over the home screen: they rise in and sink away. -->
    <style name="State" parent="Home">
        <item name="android:windowAnimationStyle">@style/StateMotion</item>
    </style>

    <style name="StateMotion" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/state_in</item>
        <item name="android:activityOpenExitAnimation">@anim/state_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/state_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/state_out</item>
    </style>
</resources>
